<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / ASP.NET Core Module (ANCM) configuration for Plesk hosting.
  - processPath/arguments target a self-contained publish (.\Portfolio.Web.exe),
    so the server only needs the ANCM hosting module, not a matching .NET runtime.
  - stdoutLogEnabled is TRUE for the first deploy (Phase 0) to make the runtime
    probe debuggable. Turn it OFF once the site is confirmed healthy.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\Portfolio.Web.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
