@page "/about"
@inject IOptions<SiteOptions> SiteOpt
@{
    ViewData["Title"] = "About";
    var site = SiteOpt.Value;
    ViewData["Description"] = site.Summary;

    // Fixed icon set, zipped with the configured value-prop cards by position.
    var propIcons = new[]
    {
        "<path d='M3 7l9-4 9 4-9 4-9-4Z' /><path d='M3 12l9 4 9-4' /><path d='M3 17l9 4 9-4' />",
        "<path d='M13 2 4 14h7l-1 8 9-12h-7l1-8Z' />",
        "<path d='M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z' /><path d='M9 12l2 2 4-4' />",
        "<circle cx='12' cy='12' r='3' /><path d='M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1' />",
    };
}

<section class="container-page py-16 md:py-20">
    <p class="eyebrow">About</p>
    <h1 class="mt-3 max-w-3xl text-3xl leading-tight md:text-5xl">
        @site.About.Headline
    </h1>

    @if (site.About.ValueProps.Count > 0)
    {
        <!-- VALUE PROPS -->
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @for (var i = 0; i < site.About.ValueProps.Count; i++)
            {
                var vp = site.About.ValueProps[i];
                <div class="card">
                    <svg class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        @Html.Raw(propIcons[i % propIcons.Length])
                    </svg>
                    <h2 class="mt-4 text-base text-text">@vp.Title</h2>
                    <p class="mt-1.5 text-sm text-muted">@vp.Body</p>
                </div>
            }
        </div>
    }

    <div class="mt-12 grid gap-12 md:grid-cols-[1.6fr_1fr]">
        <div class="article max-w-2xl">
            @foreach (var para in site.About.Paragraphs)
            {
                <p>@para</p>
            }
        </div>

        <aside class="space-y-6">
            @if (site.HasPhoto)
            {
                <img src="@site.PhotoUrl" alt="@site.OwnerName"
                     class="w-full max-w-xs rounded-lg border border-border object-cover"
                     width="320" height="320" loading="lazy" />
            }
            @if (!string.IsNullOrWhiteSpace(site.About.CurrentlyNote))
            {
                <div class="card">
                    <p class="eyebrow">Currently</p>
                    <p class="mt-3 text-sm text-muted">@site.About.CurrentlyNote</p>
                </div>
            }
            @if (site.About.Focus.Count > 0)
            {
                <div class="card">
                    <p class="eyebrow">Focus</p>
                    <ul class="mt-3 space-y-1.5 font-mono text-xs text-muted">
                        @foreach (var f in site.About.Focus)
                        {
                            <li>▸ @f</li>
                        }
                    </ul>
                </div>
            }
            <a href="/cv" class="btn btn-ghost w-full justify-center">View the full CV →</a>
        </aside>
    </div>
</section>
