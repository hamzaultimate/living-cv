@page "/skills"
@attribute [SectionPage(SectionRegistry.Skills)]
@inject PortfolioContentService Repo
@inject RequestTemplate Template
@{
    var tpl = await Template.GetAsync();
    var copy = tpl.Copy.Skills;
    ViewData["Title"] = copy.Title;
    ViewData["Description"] = TemplateSeo.Apply(copy.Description, tpl.Site);
    var skills = await Repo.GetSkillsAsync();
    var order = tpl.Definition.SkillGroups;
    var groups = skills.GroupBy(s => s.Group).OrderBy(g => { var i = order.IndexOf(g.Key); return i < 0 ? int.MaxValue : i; });
    var absBase = await SeoHelpers.AbsoluteBaseAsync(HttpContext);
    var breadcrumbLd = SeoHelpers.BreadcrumbJsonLd(absBase, ("Home", "/"), (copy.Title, "/skills"));
}
<script type="application/ld+json">@Html.Raw(breadcrumbLd)</script>

<section class="container-page py-16 md:py-20">
    <p class="eyebrow">@Text(copy.Eyebrow)</p>
    <h1 class="mt-3 text-3xl md:text-4xl">@Text(copy.Heading)</h1>
    <p class="lead">@Text(copy.Lead)</p>

    @if (skills.Count == 0)
    {
        <p class="mt-10 font-mono text-sm text-muted">@Text(copy.Empty)</p>
    }
    else
    {
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var g in groups)
            {
                <div class="card">
                    <p class="eyebrow">@g.Key</p>
                    <div class="mt-4 flex flex-wrap gap-2">
                        @foreach (var s in g)
                        {
                            <span class="tag">@s.Name</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>
