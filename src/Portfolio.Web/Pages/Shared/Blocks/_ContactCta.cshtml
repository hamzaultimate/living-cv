@model IndexModel
@inject ISiteProfileProvider SiteProfile
@inject RequestTemplate Template
@{
    var site = await SiteProfile.GetAsync();
    var tpl = await Template.GetAsync();
    var copy = tpl.Copy.Home;
}
<!-- CONTACT -->
<section id="contact" class="border-t border-border/60">
    <div class="container-page py-16 md:py-20">
        <p class="eyebrow">Contact</p>
        <h2 class="mt-3 max-w-2xl text-2xl md:text-3xl">@Text(copy.ContactHeading)</h2>
        <div class="mt-6 flex flex-wrap gap-3">
            @if (site.HasEmail)
            {
                <a href="@site.EmailHref" class="btn btn-primary">Email</a>
            }
            @if (site.HasLinkedIn)
            {
                <a href="@site.LinkedIn" target="_blank" rel="me noopener" class="btn btn-ghost">LinkedIn</a>
            }
            @if (site.HasGitHub)
            {
                <a href="@site.GitHub" target="_blank" rel="me noopener" class="btn btn-ghost">GitHub</a>
            }
            @if (tpl.IsEnabled(SectionRegistry.Contact))
            {
            <a href="/contact" class="btn btn-ghost">All contact options →</a>
            }
        </div>
    </div>
</section>