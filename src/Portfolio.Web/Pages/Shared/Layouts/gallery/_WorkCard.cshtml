@model WorkCard
@inject RequestTemplate Template
@{
    var tpl = await Template.GetAsync();
    var copy = tpl.Copy.Projects;
    var item = tpl.Section(SectionRegistry.Projects).ItemLabel ?? "";
    var p = Model.Project;
    // The gallery never plays media: a cover that is a video file shows the text tile, and the video is linked from the entry's links instead.
    var hasImage = !string.IsNullOrWhiteSpace(p.HeroImage) && !Media.IsVideo(p.HeroImage);
    var cat = p.Category?.Trim();
    var mark = string.Concat(p.Title.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetterOrDigit(w[0])).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}
<article class="group relative flex flex-col" data-category="@cat">
    <div class="relative aspect-[var(--gallery-card-aspect,4/3)] overflow-hidden rounded-lg border border-border bg-surface-2">
        @if (hasImage)
        {
            <img src="@p.HeroImage" alt="@(string.IsNullOrWhiteSpace(p.HeroImageAlt) ? copy.AltFor(p.Title) : p.HeroImageAlt)" loading="lazy" width="800" height="600"
                 class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100" />
        }
        else
        {
            <div class="flex h-full w-full items-end p-5" aria-hidden="true">
                <span class="font-display text-6xl font-semibold text-accent">@mark</span>
            </div>
        }
        @if (Model.ShowFeatured && p.Featured)
        {
            <span class="absolute left-3 top-3 rounded bg-bg/90 px-2 py-0.5 text-[10px] uppercase tracking-wider text-accent">@Text(copy.FeaturedBadge)</span>
        }
    </div>
    <div class="mt-4 flex flex-1 flex-col">
        @if (!string.IsNullOrWhiteSpace(cat))
        {
            <p class="text-[11px] uppercase tracking-wider text-muted">@cat</p>
        }
        @if (Model.HeadingLevel == 2)
        {
            <h2 class="mt-1 text-xl"><a href="/projects/@p.Slug" class="text-text after:absolute after:inset-0 hover:text-accent">@p.Title</a></h2>
        }
        else
        {
            <h3 class="mt-1 text-xl"><a href="/projects/@p.Slug" class="text-text after:absolute after:inset-0 hover:text-accent">@p.Title</a></h3>
        }
        <p class="mt-2 line-clamp-2 text-sm text-muted">@p.Summary</p>
        @if (p.Tech.Count > 0)
        {
            <div class="mt-3 flex flex-wrap gap-2">
                @foreach (var t in p.Tech.Take(3))
                {
                    <span class="tag">@t</span>
                }
            </div>
        }
        <p class="mt-3 text-xs text-muted group-hover:text-accent" aria-hidden="true">@Text($"Read {item.ToLowerInvariant()} →")</p>
    </div>
</article>
