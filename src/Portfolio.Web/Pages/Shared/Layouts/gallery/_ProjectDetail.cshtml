@model ProjectPage
@inject PortfolioContentService Repo
@inject RequestTemplate Template
@{
    var tpl = await Template.GetAsync();
    var copy = tpl.Copy.Projects;
    var work = tpl.Section(SectionRegistry.Projects);
    var item = work.ItemLabel ?? "";
    var p = Model.Project;
    // The gallery never plays media, so a cover that is a video file is left out and the video is linked from the entry's links.
    var hasHero = !string.IsNullOrWhiteSpace(p.HeroImage) && !Media.IsVideo(p.HeroImage);
    var shots = p.Screenshots.Where(s => !Media.IsVideo(s.Url)).ToList();
    var all = await Repo.GetProjectsAsync();
    var at = all.FindIndex(x => x.Id == p.Id);
    var next = all.Count > 1 && at >= 0 ? all[(at + 1) % all.Count] : null;
}
<script type="application/ld+json">@Html.Raw(Model.BreadcrumbJsonLd)</script>
<script type="application/ld+json">@Html.Raw(Model.ProjectJsonLd)</script>

<article class="container-page py-16 md:py-20">
    <a href="/projects" class="font-mono text-xs text-muted hover:text-accent">@Text($"← {work.Label}")</a>

    <header class="mt-6 max-w-4xl">
        <p class="eyebrow">@Text(item)</p>
        <h1 class="mt-3 text-4xl font-semibold leading-[1.08] md:text-6xl">@p.Title</h1>
        <p class="mt-3 font-mono text-xs text-muted">
            @string.Join(" · ", new[] { p.Role, p.Org, p.Period }.Where(x => !string.IsNullOrWhiteSpace(x)))
        </p>
        <p class="mt-5 max-w-3xl text-lg text-muted">@p.Summary</p>
    </header>

    @if (hasHero)
    {
        <figure class="mt-10 overflow-hidden rounded-lg border border-border">
            <img src="@p.HeroImage" alt="@(string.IsNullOrWhiteSpace(p.HeroImageAlt) ? p.Title : p.HeroImageAlt)" class="aspect-[3/2] w-full object-cover" width="1200" height="800" fetchpriority="high" />
        </figure>
    }

    @if (p.Impact.Count > 0)
    {
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var m in p.Impact)
            {
                <li class="border-l-2 border-accent pl-4 text-lg leading-snug text-text">@m</li>
            }
        </ul>
    }

    <div class="mt-12 grid gap-10 md:grid-cols-[1.6fr_1fr]">
        <div class="article max-w-2xl">
            @if (!string.IsNullOrWhiteSpace(p.Problem))
            {
                <h2>@Text(copy.ProblemHeading)</h2>
                <p>@p.Problem</p>
            }
            @if (!string.IsNullOrWhiteSpace(p.Approach))
            {
                <h2>@Text(copy.ApproachHeading)</h2>
                <p>@p.Approach</p>
            }
            @if (string.IsNullOrWhiteSpace(p.Problem) && string.IsNullOrWhiteSpace(p.Approach))
            {
                <p class="text-muted">@Text(copy.NoWriteup)</p>
            }
        </div>

        <aside class="space-y-6">
            @if (p.Tech.Count > 0)
            {
                <div>
                    <p class="eyebrow">@Text(copy.StackHeading)</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var t in p.Tech)
                        {
                            <span class="tag">@t</span>
                        }
                    </div>
                </div>
            }
            @if (p.Links.Count > 0)
            {
                <div>
                    <p class="eyebrow">@Text(copy.LinksHeading)</p>
                    <ul class="mt-3 space-y-2">
                        @foreach (var l in p.Links)
                        {
                            <li><a href="@l.Url" target="_blank" rel="noopener" class="text-sm text-accent hover:text-accent-strong">@l.Label →</a></li>
                        }
                    </ul>
                </div>
            }
            @if (p.Proofs.Count > 0)
            {
                <div>
                    <p class="eyebrow">@Text(copy.ProofHeading)</p>
                    <ul class="mt-3 space-y-2">
                        @foreach (var pr in p.Proofs)
                        {
                            <li><a href="@pr.Url" target="_blank" rel="noopener" class="text-sm text-accent hover:text-accent-strong">@pr.Label →</a></li>
                        }
                    </ul>
                </div>
            }
        </aside>
    </div>

    @if (shots.Count > 0)
    {
        <section class="mt-14" data-lightbox-gallery aria-label="@copy.GalleryLabel">
            <p class="eyebrow">@Text(copy.ScreenshotsHeading)</p>
            <div class="mt-4 grid gap-6 sm:grid-cols-2">
                @for (var i = 0; i < shots.Count; i++)
                {
                    var shot = shots[i];
                    <figure class="@(i == 0 ? "sm:col-span-2" : "")">
                        <button type="button"
                                class="group relative block w-full overflow-hidden rounded-lg border border-border transition hover:border-accent/50"
                                data-lightbox-item data-src="@shot.Url" data-caption="@shot.Caption" data-video="false" data-index="@i"
                                aria-label="@copy.OpenImageLabel@(string.IsNullOrWhiteSpace(shot.Caption) ? "" : ": " + shot.Caption)">
                            <img src="@shot.Url" alt="@(shot.Caption ?? copy.AltFor(p.Title))" loading="lazy"
                                 class="@(i == 0 ? "aspect-[16/10]" : "aspect-[4/3]") w-full object-cover transition duration-500 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100" />
                        </button>
                        @if (!string.IsNullOrWhiteSpace(shot.Caption))
                        {
                            <figcaption class="mt-2 text-sm text-muted">@shot.Caption</figcaption>
                        }
                    </figure>
                }
            </div>
        </section>
    }

    @if (next is not null)
    {
        <nav class="mt-16 border-t border-border/60 pt-8" aria-label="@work.Label">
            <a href="/projects/@next.Slug" class="group block">
                <span class="eyebrow">@Text($"Next {item.ToLowerInvariant()}")</span>
                <span class="mt-2 block text-2xl text-text group-hover:text-accent md:text-3xl">@next.Title →</span>
            </a>
        </nav>
    }
</article>
