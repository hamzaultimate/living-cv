@model IndexModel
@inject ISiteProfileProvider SiteProfile
@inject RequestTemplate Template
@{
    var site = await SiteProfile.GetAsync();
    var tpl = await Template.GetAsync();
    var copy = tpl.Copy.Home;
    var certCopy = tpl.Copy.Certifications;
    var credentials = Model.Certifications.Take(6).ToList();
    var order = tpl.Definition.SkillGroups;
    var skillGroups = Model.Skills.GroupBy(s => s.Group)
        .OrderBy(g => { var i = order.IndexOf(g.Key); return i < 0 ? int.MaxValue : i; })
        .ToList();
}
<!-- HERO -->
<section class="border-b border-border/60">
    <div class="container-page flex flex-col-reverse items-start gap-10 py-16 md:flex-row md:items-center md:justify-between md:py-24">
        <div>
            <p class="eyebrow">@site.Hero.Eyebrow</p>
            <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.15] md:text-5xl">
                @site.Hero.Headline
                <span class="text-accent">@site.Hero.HeadlineAccent</span>
            </h1>
            <p class="mt-6 max-w-2xl text-lg text-muted">@site.Hero.Lede</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/cv" class="btn btn-primary">Download CV</a>
                @if (site.HasLinkedIn)
                {
                    <a href="@site.LinkedIn" target="_blank" rel="me noopener" class="btn btn-ghost">LinkedIn</a>
                }
                @if (tpl.IsEnabled(SectionRegistry.Contact))
                {
                    <a href="/contact" class="btn btn-ghost">Contact</a>
                }
            </div>
        </div>
        @if (site.HasPhoto)
        {
            <div class="shrink-0">
                <img src="@site.PhotoUrl" alt="@site.OwnerName"
                     class="profile-photo profile-photo--dark h-40 w-40 rounded-lg border border-border object-cover md:h-56 md:w-56"
                     width="224" height="224" fetchpriority="high" />
                @if (site.HasPhotoLight)
                {
                    <img src="@site.PhotoUrlLight" alt="@site.OwnerName"
                         class="profile-photo profile-photo--light h-40 w-40 rounded-lg border border-border object-cover md:h-56 md:w-56"
                         width="224" height="224" loading="lazy" />
                }
            </div>
        }
        else
        {
            <div class="flex h-40 w-40 shrink-0 items-center justify-center rounded-lg border border-border bg-surface font-display text-5xl font-semibold text-accent md:h-56 md:w-56 md:text-7xl"
                 role="img" aria-label="@site.OwnerName">@site.Initials</div>
        }
    </div>
</section>

@if (credentials.Count > 0)
{
    <!-- CREDENTIALS -->
    <section id="credentials" class="border-b border-border/60">
        <div class="container-page py-14 md:py-16">
            <p class="eyebrow">@Text(copy.CredentialsEyebrow)</p>
            <h2 class="mt-3 text-2xl md:text-3xl">@Text(copy.CredentialsHeading)</h2>
            <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var c in credentials)
                {
                    <article class="card flex flex-col gap-2">
                        <div class="flex items-start justify-between gap-3">
                            <h3 class="text-base text-text">@c.Name</h3>
                            <span class="@CertificationBadges.Css(c.Status) shrink-0">@CertificationBadges.Label(c.Status, certCopy)</span>
                        </div>
                        <p class="text-sm text-muted">@c.Issuer@(string.IsNullOrWhiteSpace(c.Date) ? "" : " · " + c.Date)</p>
                    </article>
                }
            </div>
            <a href="/certifications" class="mt-6 inline-block font-mono text-xs text-muted hover:text-accent">View all →</a>
        </div>
    </section>
}

@if (site.Metrics.Count > 0)
{
    <!-- METRICS -->
    <section class="border-b border-border/60">
        <div class="container-page grid grid-cols-2 gap-8 py-12 md:grid-cols-4">
            @foreach (var m in site.Metrics)
            {
                <div>
                    <div class="metric-value">@m.Value@if (!string.IsNullOrWhiteSpace(m.Unit)) {<span class="text-lg text-muted"> @m.Unit</span>}</div>
                    <div class="metric-label">@m.Label</div>
                </div>
            }
        </div>
    </section>
}

@if (Model.RecentRoles.Count > 0)
{
    <!-- PRACTICE -->
    <section id="practice" class="border-b border-border/60">
        <div class="container-page py-14 md:py-16">
            <p class="eyebrow">@Text(copy.ExperienceEyebrow)</p>
            <h2 class="mt-3 text-2xl md:text-3xl">@Text(copy.ExperienceHeading)</h2>
            <div class="mt-8 space-y-8 border-l border-border pl-6 md:pl-8">
                @foreach (var r in Model.RecentRoles)
                {
                    <article>
                        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                            <h3 class="text-lg text-text">@r.Company</h3>
                            <span class="font-mono text-xs text-muted">@r.Start – @(r.Current ? "present" : r.End)</span>
                        </div>
                        <p class="mt-1 font-mono text-sm text-accent">@r.Title</p>
                        <p class="mt-3 max-w-2xl text-sm text-muted">@r.Summary</p>
                    </article>
                }
            </div>
            <a href="/experience" class="mt-8 inline-block font-mono text-xs text-muted hover:text-accent">View all →</a>
        </div>
    </section>
}

@if (skillGroups.Count > 0)
{
    <!-- SKILLS -->
    <section id="skills" class="border-b border-border/60">
        <div class="container-page py-14 md:py-16">
            <h2 class="text-2xl md:text-3xl">@Text(copy.SkillsHeading)</h2>
            <div class="mt-8 grid gap-5 sm:grid-cols-2">
                @foreach (var g in skillGroups)
                {
                    <div class="card">
                        <p class="eyebrow">@g.Key</p>
                        <div class="mt-4 flex flex-wrap gap-2">
                            @foreach (var s in g)
                            {
                                <span class="tag">@s.Name</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@await Html.PartialAsync("Blocks/_FeaturedWork", Model)

@await Html.PartialAsync("Blocks/_Testimonials", Model)

@await Html.PartialAsync("Blocks/_ContactCta", Model)
