@model WorkCard
@inject RequestTemplate Template
@{
    var tpl = await Template.GetAsync();
    var copy = tpl.Copy.Projects;
    var item = tpl.Section(SectionRegistry.Projects).ItemLabel ?? "";
    var p = Model.Project;
    // The results layout never plays media: a cover that is a video file shows the text tile with a plain link to the file.
    var hasImage = !string.IsNullOrWhiteSpace(p.HeroImage) && !Media.IsVideo(p.HeroImage);
    var coverVideo = !hasImage && Media.IsVideo(p.HeroImage) && LayoutPartials.IsLinkable(p.HeroImage);
    var cat = p.Category?.Trim();
    var org = p.Org?.Trim();
    // The card leads with the first impact line: its figure set large, the rest of the line beside it. The other lines are on the case-study page.
    var leadText = p.Impact.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
    var lead = ImpactLine.Split(leadText);
    var mark = string.Concat(p.Title.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetterOrDigit(w[0])).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}
<article class="group relative mx-auto flex w-full min-w-0 max-w-[var(--results-card-max,40rem)] flex-col" data-results-card data-category="@cat">
    <div class="relative aspect-[var(--results-card-aspect,16/10)] overflow-hidden rounded-lg border border-border bg-surface-2">
        @if (hasImage)
        {
            <img src="@p.HeroImage" alt="@(string.IsNullOrWhiteSpace(p.HeroImageAlt) ? copy.AltFor(p.Title) : p.HeroImageAlt)" loading="lazy" width="800" height="500"
                 class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100" />
        }
        else
        {
            <div class="flex h-full w-full items-end p-5" aria-hidden="true">
                <span class="font-display text-6xl font-semibold text-accent">@mark</span>
            </div>
        }
        @if (coverVideo)
        {
            <a href="@p.HeroImage" target="_blank" rel="noopener" class="absolute bottom-3 right-3 z-10 rounded bg-bg/90 px-2 py-1 text-xs text-accent hover:text-accent-strong">@Text(copy.WatchVideoText())</a>
        }
        @if (Model.ShowFeatured && p.Featured)
        {
            <span class="absolute left-3 top-3 rounded bg-bg/90 px-2 py-0.5 text-[10px] uppercase tracking-wider text-accent">@Text(copy.FeaturedBadge)</span>
        }
    </div>
    <div class="mt-4 flex flex-1 flex-col">
        @if (!string.IsNullOrWhiteSpace(cat))
        {
            <p class="break-words text-[11px] uppercase tracking-wider text-muted">@cat</p>
        }
        @if (Model.HeadingLevel == 2)
        {
            <h2 class="mt-1 break-words text-xl"><a href="/projects/@p.Slug" class="text-text after:absolute after:inset-0 hover:text-accent">@p.Title</a></h2>
        }
        else
        {
            <h3 class="mt-1 break-words text-xl"><a href="/projects/@p.Slug" class="text-text after:absolute after:inset-0 hover:text-accent">@p.Title</a></h3>
        }
        @if (!string.IsNullOrWhiteSpace(org))
        {
            <p class="mt-1 break-words text-xs text-muted">@org</p>
        }
        @if (leadText is not null)
        {
            <p class="mt-3 min-w-0 break-words border-l-2 border-accent pl-3" data-results-lead>
                @if (lead.HasFigure)
                {
                    <span class="block break-words font-display text-3xl font-semibold leading-tight text-accent">@lead.Figure</span>
                    @if (lead.Rest.Length > 0)
                    {
                        <span class="block break-words text-sm text-text">@lead.Rest</span>
                    }
                }
                else
                {
                    <span class="block break-words text-sm text-text">@lead.Rest</span>
                }
            </p>
        }
        <p class="mt-3 line-clamp-2 break-words text-sm text-muted">@p.Summary</p>
        @if (p.Tech.Count > 0)
        {
            <div class="mt-3 flex flex-wrap gap-2">
                @foreach (var t in p.Tech.Take(3))
                {
                    <span class="tag max-w-full break-words">@t</span>
                }
            </div>
        }
        <p class="mt-3 text-xs text-muted group-hover:text-accent" aria-hidden="true">@Text(copy.ReadItemFor(item))</p>
    </div>
</article>
