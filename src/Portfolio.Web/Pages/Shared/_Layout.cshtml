@inject IOptions<SiteOptions> SiteOpt
@{
    var site = SiteOpt.Value;
    // Most pages get "Section · Name". The homepage leads with the name + role instead —
    // that's what people actually search ("<name> <job title>"), and it's the page most
    // likely to rank for a name search, so it gets the full literal title via FullTitle.
    var pageTitle = ViewData["FullTitle"] as string ?? $"{ViewData["Title"]} · {site.OwnerName}";
    var pageDesc = ViewData["Description"] as string ?? site.Summary;
    var absBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var absUrl = $"{absBase}{Context.Request.Path}";
    // Blog posts and project case studies pass their own cover/hero image (relative path)
    // so a link shared on LinkedIn/X shows the actual post, not the generic name card.
    var ogImageOverride = ViewData["OgImage"] as string;
    var ogImage = string.IsNullOrWhiteSpace(ogImageOverride)
        ? $"{absBase}/og.png"
        : ogImageOverride.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? ogImageOverride : $"{absBase}{ogImageOverride}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (t !== 'light' && t !== 'dark') {
                    t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
                }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
        })();
    </script>
    <title>@pageTitle</title>
    <meta name="description" content="@pageDesc" />
    @if (ViewData["Robots"] as string is { Length: > 0 } robots)
    {
        <meta name="robots" content="@robots" />
    }
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href="@absUrl" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@site.OwnerName" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDesc" />
    <meta property="og:url" content="@absUrl" />
    <meta property="og:image" content="@ogImage" />
    @if (ogImageOverride is null)
    {
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDesc" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="preload" href="~/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-bg">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-border/70 bg-bg/80 backdrop-blur">
        <div class="container-page flex h-16 items-center justify-between">
            <a href="/" class="font-display text-lg font-semibold tracking-tight text-text transition-colors hover:text-accent">
                @site.BrandName<span class="text-accent">.</span>
            </a>
            <nav class="hidden items-center gap-6 md:flex">
                <a class="nav-link" href="/about">about</a>
                <a class="nav-link" href="/experience">experience</a>
                <a class="nav-link" href="/projects">work</a>
                <a class="nav-link" href="/skills">skills</a>
                <a class="nav-link" href="/certifications">certs</a>
                <a class="nav-link" href="/blog">blog</a>
                <a class="nav-link" href="/talks">talks</a>
                <a class="nav-link" href="/cv">cv</a>
            </nav>
            <div class="flex items-center gap-3">
                <button id="theme-btn" class="text-muted hover:text-accent" aria-label="Toggle light/dark theme">
                    <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                    <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
                    </svg>
                </button>
                <a href="/contact" class="btn btn-primary hidden text-xs sm:inline-flex">Get in touch</a>
                <button id="menu-btn" class="md:hidden text-muted hover:text-text" aria-label="Toggle menu" aria-expanded="false">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
                    </svg>
                </button>
            </div>
        </div>
        <nav id="mobile-nav" class="hidden border-t border-border/70 md:hidden">
            <div class="container-page flex flex-col py-3">
                <a class="nav-link py-2" href="/about">about</a>
                <a class="nav-link py-2" href="/experience">experience</a>
                <a class="nav-link py-2" href="/projects">work</a>
                <a class="nav-link py-2" href="/skills">skills</a>
                <a class="nav-link py-2" href="/certifications">certifications</a>
                <a class="nav-link py-2" href="/blog">blog</a>
                <a class="nav-link py-2" href="/talks">talks</a>
                <a class="nav-link py-2" href="/cv">cv</a>
                <a class="nav-link py-2" href="/contact">contact</a>
            </div>
        </nav>
    </header>

    <main id="main-content" class="flex-1">
        @RenderBody()
    </main>

    <footer class="border-t border-border/70">
        <div class="container-page flex flex-col gap-4 py-8 md:flex-row md:items-center md:justify-between">
            <p class="font-mono text-xs text-muted">© @DateTime.UtcNow.Year @site.OwnerName</p>
            <div class="flex flex-wrap gap-4 font-mono text-xs">
                @if (site.HasLinkedIn)
                {
                    <a class="text-muted hover:text-accent" href="@site.LinkedIn" rel="me noopener" target="_blank">LinkedIn</a>
                }
                @if (site.HasGitHub)
                {
                    <a class="text-muted hover:text-accent" href="@site.GitHub" rel="me noopener" target="_blank">GitHub</a>
                }
                @if (site.HasEmail)
                {
                    <a class="text-muted hover:text-accent" href="@site.EmailHref">Email</a>
                }
            </div>
            <p class="font-mono text-xs text-muted">ASP.NET Core · SQL Server · Plesk</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
