@page
@model IndexModel
@inject ISiteProfileProvider SiteProfile
@inject RequestTemplate Template
@{
    var site = await SiteProfile.GetAsync();
    var tpl = await Template.GetAsync();
    var seo = tpl.Definition.Seo;
    ViewData["Title"] = "Home";
    // Search engines truncate/flag title >~65 chars and description outside ~70-160 chars.
    // site.Role and site.Summary are the long-form versions used on /cv and the CV PDF —
    // give the homepage its own shorter copy instead of shortening those shared strings.
    ViewData["FullTitle"] = TemplateSeo.Apply(seo.Title, site);
    ViewData["Description"] = TemplateSeo.Apply(seo.Description, site);
    var sameAs = new[] { site.HasLinkedIn ? site.LinkedIn : null, site.HasGitHub ? site.GitHub : null, site.HasYouTube ? site.YouTube : null }
        .Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
    var person = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = site.OwnerName,
        ["jobTitle"] = site.JobTitle,
        ["url"] = site.Url,
        ["knowsAbout"] = site.KnowsAbout,
    };
    if (site.HasEmail) person["email"] = site.Email;
    if (site.HasPhone) person["telephone"] = site.Phone;
    if (sameAs.Length > 0) person["sameAs"] = sameAs;
    // Credentials are listed only when the template asks for it and has the section enabled.
    if (seo.CredentialsJsonLd && Model.Certifications.Count > 0)
    {
        person["hasCredential"] = Model.Certifications.Select(c => new Dictionary<string, object?>
        {
            ["@type"] = "EducationalOccupationalCredential",
            ["name"] = c.Name,
            ["recognizedBy"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = c.Issuer },
        }).ToArray();
    }
    var jsonLd = System.Text.Json.JsonSerializer.Serialize(person);
}
<script type="application/ld+json">@Html.Raw(jsonLd)</script>

@await Html.PartialAsync($"Layouts/{tpl.Archetype}/_Home", Model)