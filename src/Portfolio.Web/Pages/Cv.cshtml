@page "/cv"
@inject PortfolioContentService Repo
@inject IOptions<SiteOptions> SiteOpt
@inject CvAtsReportProvider AtsReportProvider
@{
    ViewData["Title"] = "CV";
    var site = SiteOpt.Value;
    ViewData["Description"] = $"Curriculum vitae — {site.OwnerName}, {site.JobTitle}.";
    var data = await Repo.BuildCvDataAsync(site);
    var roles = data.Experience;
    var groups = data.SkillGroups;
    var projects = data.Projects;
    var certs = data.Certifications;
    var contacts = data.Contacts;
    var atsReport = AtsReportProvider.GetReport();
    var absBase = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}";
    var breadcrumbLd = SeoHelpers.BreadcrumbJsonLd(absBase, ("Home", "/"), ("CV", "/cv"));
}
<script type="application/ld+json">@Html.Raw(breadcrumbLd)</script>

<section class="container-page py-16 md:py-20 print-light">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl md:text-4xl">@site.OwnerName</h1>
            <p class="mt-2 font-mono text-sm text-accent">@site.Role</p>
            @if (contacts.Any())
            {
                <p class="mt-2 font-mono text-xs text-muted">@string.Join("  ·  ", contacts)</p>
            }
        </div>
        <div class="flex flex-wrap items-start gap-3 no-print">
            <a href="/cv.pdf" class="btn btn-primary">Download PDF</a>
            <button onclick="window.print()" class="btn btn-ghost">Print</button>
            @if (atsReport is not null)
            {
                <details>
                    <summary class="btn btn-ghost">ATS Score: @atsReport.CombinedScore/100</summary>
                    <div class="card mt-3 max-w-md text-sm">
                        <p class="font-mono text-xs text-muted">
                            Rules @atsReport.RuleScore/100
                            @if (atsReport.AiScore.HasValue)
                            {
                                <text> · AI review @atsReport.AiScore/100</text>
                            }
                        </p>
                        <ul class="mt-2 space-y-1">
                            @foreach (var finding in atsReport.Findings)
                            {
                                <li class="@(finding.Passed ? "text-muted" : "text-accent")">@(finding.Passed ? "✓" : "✗") @finding.Message</li>
                            }
                        </ul>
                        @if (atsReport.AiStrengths.Count > 0)
                        {
                            <p class="mt-3 font-mono text-xs text-muted">Strengths</p>
                            <ul class="mt-1 space-y-1">
                                @foreach (var strength in atsReport.AiStrengths)
                                {
                                    <li>@strength</li>
                                }
                            </ul>
                        }
                        @if (atsReport.AiCritiques.Count > 0)
                        {
                            <p class="mt-3 font-mono text-xs text-muted">To improve</p>
                            <ul class="mt-1 space-y-1">
                                @foreach (var critique in atsReport.AiCritiques)
                                {
                                    <li>△ @critique</li>
                                }
                            </ul>
                        }
                    </div>
                </details>
            }
        </div>
    </div>

    <p class="mt-8 max-w-3xl text-muted">@site.Summary</p>

    @if (roles.Count > 0)
    {
        <h2 class="mt-12 text-xl">Experience</h2>
        <div class="mt-4 space-y-6">
            @foreach (var r in roles)
            {
                <div>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                        <p class="text-text">@r.Company — <span class="text-muted">@r.Title</span></p>
                        <span class="font-mono text-xs text-muted">@r.Start – @(r.Current ? "present" : r.End)</span>
                    </div>
                    <p class="mt-1 max-w-2xl text-sm text-muted">@r.Summary</p>
                    @if (r.Highlights.Count > 0)
                    {
                        <ul class="mt-2 space-y-1">
                            @foreach (var h in r.Highlights)
                            {
                                <li class="text-sm text-muted"><span class="text-accent">▸</span> @h</li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    }

    @if (groups.Count > 0)
    {
        <h2 class="mt-12 text-xl">Skills</h2>
        <div class="mt-4 space-y-2">
            @foreach (var g in groups)
            {
                <p class="text-sm"><span class="font-mono text-xs uppercase tracking-wider text-accent">@g.Key</span>
                    <span class="text-muted"> — @string.Join(", ", g.Select(s => s.Name))</span></p>
            }
        </div>
    }

    @if (projects.Count > 0)
    {
        <h2 class="mt-12 text-xl">Selected projects</h2>
        <div class="mt-4 space-y-4">
            @foreach (var p in projects)
            {
                <div>
                    <p class="text-text">@p.Title</p>
                    <p class="text-sm text-muted">@p.Summary</p>
                    @if (p.Impact.Count > 0)
                    {
                        <p class="mt-1 font-mono text-xs text-accent">▸ @string.Join("  ·  ", p.Impact)</p>
                    }
                </div>
            }
        </div>
    }

    @if (certs.Count > 0)
    {
        <h2 class="mt-12 text-xl">Certifications</h2>
        <ul class="mt-4 space-y-1">
            @foreach (var c in certs)
            {
                <li class="text-sm text-muted">@c.Name — <span class="font-mono text-xs">@c.Issuer (@c.Status)</span></li>
            }
        </ul>
    }
</section>
