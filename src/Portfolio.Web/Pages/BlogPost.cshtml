@page "/blog/{slug}"
@inject PortfolioContentService Repo
@inject IOptions<SiteOptions> SiteOpt
@{
    var site = SiteOpt.Value;
    var slug = RouteData.Values["slug"]?.ToString() ?? "";
    var post = await Repo.GetBlogPostAsync(slug);
    string? jsonLd = null;
    string? breadcrumbLd = null;
    if (post is null)
    {
        Response.StatusCode = 404;
        ViewData["Title"] = "Not found";
    }
    else
    {
        ViewData["Title"] = post.Title;
        ViewData["Description"] = post.Description;
        if (!string.IsNullOrWhiteSpace(post.Cover)) ViewData["OgImage"] = post.Cover;
        var absBase = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}";
        var article = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BlogPosting",
            ["headline"] = post.Title,
            ["description"] = post.Description,
            ["datePublished"] = post.Date.ToString("yyyy-MM-dd"),
            ["url"] = $"{absBase}/blog/{post.Slug}",
            ["mainEntityOfPage"] = $"{absBase}/blog/{post.Slug}",
            ["author"] = new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = site.OwnerName, ["url"] = site.Url },
        };
        if (!string.IsNullOrWhiteSpace(post.Cover)) article["image"] = $"{absBase}{post.Cover}";
        jsonLd = System.Text.Json.JsonSerializer.Serialize(article);

        // Lets Google render "Home > Blog > Post Title" in place of the raw URL in results.
        var crumbs = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = absBase },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Blog", ["item"] = $"{absBase}/blog" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = post.Title, ["item"] = $"{absBase}/blog/{post.Slug}" },
        };
        breadcrumbLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = crumbs,
        });
    }
}
@if (jsonLd is not null)
{
    <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    <script type="application/ld+json">@Html.Raw(breadcrumbLd)</script>
}

@if (post is null)
{
    <section class="container-page py-24 text-center">
        <p class="eyebrow">404</p>
        <h1 class="mt-3 text-3xl">Post not found</h1>
        <a href="/blog" class="btn btn-ghost mt-6">← Back to blog</a>
    </section>
}
else
{
    <article class="container-page py-16 md:py-20">
        <a href="/blog" class="font-mono text-xs text-muted hover:text-accent">← blog</a>
        <header class="mt-6 max-w-2xl">
            <p class="font-mono text-xs text-muted">
                @post.Date.ToString("MMM d, yyyy") · @Md.ReadingMinutes(post.BodyMarkdown) min read
            </p>
            <h1 class="mt-3 text-3xl leading-tight md:text-4xl">@post.Title</h1>
            @if (post.Tags.Count > 0)
            {
                <div class="mt-4 flex flex-wrap gap-2">
                    @foreach (var t in post.Tags)
                    {
                        <span class="tag">#@t</span>
                    }
                </div>
            }
            <div class="mt-6 flex flex-wrap items-center gap-2">
                <span class="font-mono text-xs text-muted">Share</span>
                <button type="button" data-share="copy" data-url="/blog/@post.Slug" data-title="@post.Title"
                        class="btn btn-ghost !px-3 !py-1.5 text-xs">
                    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8h16v-8"/><path d="M12 16V4"/><path d="M8 8l4-4 4 4"/></svg>
                    <span data-share-label>Copy link</span>
                </button>
                <button type="button" data-share="x" data-url="/blog/@post.Slug" data-title="@post.Title" class="btn btn-ghost !px-3 !py-1.5 text-xs">X</button>
                <button type="button" data-share="linkedin" data-url="/blog/@post.Slug" data-title="@post.Title" class="btn btn-ghost !px-3 !py-1.5 text-xs">LinkedIn</button>
            </div>
        </header>
        @if (!string.IsNullOrWhiteSpace(post.Cover))
        {
            <img src="@post.Cover" alt="@post.Title" width="1200" height="630"
                 class="mt-8 aspect-video w-full max-w-2xl rounded-lg border border-border object-cover" />
        }
        <div class="article mt-10 max-w-2xl">
            @Html.Raw(Md.ToHtml(post.BodyMarkdown))
        </div>
    </article>
}
