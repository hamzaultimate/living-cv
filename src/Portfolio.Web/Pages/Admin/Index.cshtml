@page "/admin"
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}
<h1>Dashboard</h1>
<p class="adm-lede">Signed in as <strong>@User.Identity?.Name</strong>.</p>
@if (Model.SetupPending)
{
    <section class="adm-card adm-callout" aria-labelledby="setup-heading">
        <h2 id="setup-heading">Finish setting up your site</h2>
        <p>Your site still shows its placeholder profile. The setup wizard takes about two minutes: pick a template, enter your details, add a photo and publish. Nothing is public until you do. Afterwards, add your experience, skills, work and credentials from <a href="/admin/content">Content</a>.</p>
        <div class="adm-actions">
            <a class="adm-btn adm-btn-primary" href="@Model.ResumePath">Continue setup</a>
            <form method="post" asp-page="/Admin/Welcome/Template" asp-page-handler="Skip">
                <button type="submit" class="adm-btn">Skip setup</button>
            </form>
        </div>
    </section>
}
<div class="adm-grid">
    <a class="adm-card adm-tile" href="/admin/profile">
        <h2>Profile</h2>
        <p>Name, title, summary and contact links.</p>
    </a>
    @foreach (var (url, heading) in Model.Parts)
    {
        <a class="adm-card adm-tile" href="@url">
            <h2>@heading</h2>
            <p>Changes apply to your public site as soon as you save.</p>
        </a>
    }
    <a class="adm-card adm-tile" href="/admin/content">
        <h2>Content</h2>
        <p>Add, edit, reorder and remove your @Model.ContentLabels.</p>
    </a>
    <a class="adm-card adm-tile" href="/admin/sections">
        <h2>@Model.SectionsHeading</h2>
        <p>Show, hide, rename and reorder the sections of your site. Hiding never deletes what is in them.</p>
    </a>
    <a class="adm-card adm-tile" href="/admin/photo">
        <h2>Photo</h2>
        <p>Upload or remove the profile photo shown on the home and About pages.</p>
    </a>
    <a class="adm-card adm-tile" href="/admin/welcome">
        <h2>Setup wizard</h2>
        <p>@(Model.SetupPending ? "Pick a template, enter your details and publish." : "Run the guided setup again: template, basics, photo and accent colour. Nothing is deleted.")</p>
    </a>
    <a class="adm-card adm-tile" href="/admin/template">
        <h2>Template</h2>
        <p>Choose the layout and wording for your profession, and preview it before switching.</p>
    </a>
</div>
