@model RowButtonsVm
@using Portfolio.Web.Pages.Admin.Profile
@{
    var i = Model.Index;
}
<div class="adm-actions adm-row-actions">
    <button type="submit" id="row-@(i)-up" class="adm-btn" asp-page-handler="Move" asp-route-index="@i" asp-route-direction="up" disabled="@(i == 0)" aria-label="Move up: @Model.Name" autofocus="@(Model.FocusId == $"row-{i}-up" ? "autofocus" : null)">Move up</button>
    <button type="submit" id="row-@(i)-down" class="adm-btn" asp-page-handler="Move" asp-route-index="@i" asp-route-direction="down" disabled="@(i == Model.Count - 1)" aria-label="Move down: @Model.Name" autofocus="@(Model.FocusId == $"row-{i}-down" ? "autofocus" : null)">Move down</button>
    @if (Model.CanRemove)
    {
    <button type="submit" id="row-@(i)-remove" class="adm-btn" asp-page-handler="Remove" asp-route-index="@i" aria-label="Remove: @Model.Name" autofocus="@(Model.FocusId == $"row-{i}-remove" ? "autofocus" : null)">Remove</button>
    }
</div>
