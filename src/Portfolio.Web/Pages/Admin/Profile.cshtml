@page "/admin/profile"
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}
<h1>Profile</h1>
<p class="adm-lede">Shown on the public pages, the CV and the share image. Changes apply as soon as you save.</p>

<form method="post" asp-page="/Admin/Profile" novalidate>
    <partial name="_ErrorSummary" />
    <input type="hidden" asp-for="Form.Stamp" />

    <fieldset class="adm-fieldset">
        <legend>Identity</legend>
        <div class="adm-field">
            <label asp-for="Form.OwnerName">Full name</label>
            <input asp-for="Form.OwnerName" type="text" maxlength="200" required />
            <span asp-validation-for="Form.OwnerName"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.BrandName">Short name (wordmark)</label>
            <input asp-for="Form.BrandName" type="text" maxlength="80" required />
            <span asp-validation-for="Form.BrandName"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.Role">Role line</label>
            <input asp-for="Form.Role" type="text" maxlength="300" />
            <span asp-validation-for="Form.Role"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.JobTitle">Job title</label>
            <input asp-for="Form.JobTitle" type="text" maxlength="200" />
            <span class="adm-hint">Used for search engines and the CV.</span>
            <span asp-validation-for="Form.JobTitle"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.Location">Location</label>
            <input asp-for="Form.Location" type="text" maxlength="120" />
            <span class="adm-hint">A city or region, shown on the Contact page and in search markup. Leave empty to hide it.</span>
            <span asp-validation-for="Form.Location"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.Url">Site address</label>
            <input asp-for="Form.Url" type="url" maxlength="300" required inputmode="url" />
            <span class="adm-hint">The public address, for example https://example.com. Used for canonical links, the sitemap and sharing.</span>
            <span asp-validation-for="Form.Url"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.GoogleAnalyticsId">Google Analytics ID</label>
            <input asp-for="Form.GoogleAnalyticsId" type="text" maxlength="40" placeholder="G-XXXXXXXXXX" />
            <span class="adm-hint">Leave empty to omit the analytics script.</span>
            <span asp-validation-for="Form.GoogleAnalyticsId"></span>
        </div>
        <p class="adm-hint">The photo has its own page: <a href="/admin/photo">Photo</a>.</p>
    </fieldset>

    <fieldset class="adm-fieldset">
        <legend>Summary</legend>
        <div class="adm-field">
            <label asp-for="Form.Summary">Summary</label>
            <textarea asp-for="Form.Summary" maxlength="2000"></textarea>
            <span class="adm-hint">Used on the CV and as the default page description.</span>
            <span asp-validation-for="Form.Summary"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.KnowsAboutText">Topics you know about</label>
            <textarea asp-for="Form.KnowsAboutText"></textarea>
            <span class="adm-hint">One per line. Used for search engine markup.</span>
            <span asp-validation-for="Form.KnowsAboutText"></span>
        </div>
        <p class="adm-hint">The rest of your profile has its own pages:
            @for (var i = 0; i < Model.Parts.Count; i++)
            {
                <a href="@Model.Parts[i].Url">@Model.Parts[i].Heading</a>@(i < Model.Parts.Count - 1 ? ", " : ".")
            }
            Save this page first: unsaved changes here are not kept when you leave.</p>
    </fieldset>

    <fieldset class="adm-fieldset">
        <legend>Contact</legend>
        <div class="adm-field">
            <label asp-for="Form.Email">Email</label>
            <input asp-for="Form.Email" type="email" maxlength="300" autocomplete="off" />
            <span asp-validation-for="Form.Email"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.SecondaryEmailsText">Other email addresses</label>
            <textarea asp-for="Form.SecondaryEmailsText"></textarea>
            <span class="adm-hint">One per line, up to 5.</span>
            <span asp-validation-for="Form.SecondaryEmailsText"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.Phone">Phone</label>
            <input asp-for="Form.Phone" type="text" maxlength="40" inputmode="tel" />
            <span asp-validation-for="Form.Phone"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.WhatsApp">WhatsApp number</label>
            <input asp-for="Form.WhatsApp" type="text" maxlength="20" inputmode="numeric" />
            <span class="adm-hint">Digits only, country code first.</span>
            <span asp-validation-for="Form.WhatsApp"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.LinkedIn">LinkedIn address</label>
            <input asp-for="Form.LinkedIn" type="url" maxlength="300" />
            <span asp-validation-for="Form.LinkedIn"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.GitHub">GitHub address</label>
            <input asp-for="Form.GitHub" type="url" maxlength="300" />
            <span asp-validation-for="Form.GitHub"></span>
        </div>
        <div class="adm-field">
            <label asp-for="Form.YouTube">YouTube address</label>
            <input asp-for="Form.YouTube" type="url" maxlength="300" />
            <span asp-validation-for="Form.YouTube"></span>
        </div>
    </fieldset>

    <div class="adm-actions">
        <button type="submit" class="adm-btn adm-btn-primary">Save profile</button>
        <a class="adm-btn" href="/admin">Cancel</a>
    </div>
</form>
