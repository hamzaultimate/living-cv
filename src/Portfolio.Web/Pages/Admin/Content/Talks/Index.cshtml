@page "/admin/content/talks"
@model Portfolio.Web.Pages.Admin.Content.Talks.IndexModel
@{
    ViewData["Title"] = Model.View.SectionLabel;
}
<partial name="_List" model="Model" />
<p class="adm-hint">The public page lists entries newest first by their @Model.View.Label("date").ToLowerInvariant(), so there is no manual order. Entries without a @Model.View.Label("date").ToLowerInvariant() come last.</p>
