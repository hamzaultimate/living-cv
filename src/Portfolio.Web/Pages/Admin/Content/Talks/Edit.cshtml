@page "/admin/content/talks/edit/{id:int?}"
@model Portfolio.Web.Pages.Admin.Content.Talks.EditModel
@{
    ViewData["Title"] = (Model.IsNew ? "Add " : "Edit ") + Model.View.ItemLabelLower;
    var f = Model.Form;
}
<h1 id="page-heading">@(Model.IsNew ? "Add" : "Edit") @Model.View.ItemLabelLower</h1>
<p class="adm-lede">Appears on your @Model.View.SectionLabel.ToLowerInvariant() page. Changes apply as soon as you save.</p>
<partial name="_Guidance" model="Model.View" />

<form method="post" asp-page="/Admin/Content/Talks/Edit" asp-route-id="@Model.Id" novalidate data-unsaved-warning data-has-errors="@(ViewData.ModelState.IsValid ? "false" : "true")">
    <partial name="_ErrorSummary" />
    <input type="hidden" name="Form.Stamp" value="@f.Stamp" />
    <fieldset class="adm-fieldset">
        <legend>@Model.View.ItemLabel</legend>
        <partial name="_Field" model="@(Model.Field("title", nameof(f.Title), f.Title, maxLength: EditModel.TitleMax))" />
        <partial name="_Field" model="@(Model.Field("type", nameof(f.Type), f.Type, FieldKind.Select, options: Model.TypeOptions))" />
        <partial name="_Field" model="@(Model.Field("event", nameof(f.Event), f.Event, maxLength: EditModel.EventMax))" />
        <partial name="_Field" model="@(Model.Field("date", nameof(f.Date), f.Date, maxLength: 30))" />
    </fieldset>
    @if (Model.View.Visible("youtubeId") || Model.View.Visible("url"))
    {
        <fieldset class="adm-fieldset">
            <legend>Video and link</legend>
            <partial name="_Field" model="@(Model.Field("youtubeId", nameof(f.YoutubeId), f.YoutubeId, maxLength: 200))" />
            <partial name="_Field" model="@(Model.Field("url", nameof(f.Url), f.Url, FieldKind.Url, EditModel.UrlMax))" />
        </fieldset>
    }
    <div class="adm-actions">
        <button type="submit" class="adm-btn adm-btn-primary">Save @Model.View.ItemLabelLower</button>
        <a class="adm-btn" href="@Model.ListUrl">Cancel</a>
    </div>
</form>
@section Scripts {
    <script src="~/js/admin-unsaved.js" defer asp-append-version="true"></script>
}
