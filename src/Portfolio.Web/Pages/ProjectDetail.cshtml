@page "/projects/{slug}"
@attribute [SectionPage(SectionRegistry.Projects)]
@inject PortfolioContentService Repo
@inject ISiteProfileProvider SiteProfile
@inject RequestTemplate Template
@{
    var tpl = await Template.GetAsync();
    var copy = tpl.Copy.Projects;
    var section = tpl.Section(SectionRegistry.Projects);
    var item = section.ItemLabel ?? "";
    var slug = RouteData.Values["slug"]?.ToString() ?? "";
    var p = await Repo.GetProjectAsync(slug);
    string? breadcrumbLd = null;
    string? projectLd = null;
    if (p is null)
    {
        Response.StatusCode = 404;
        ViewData["Title"] = "Not found";
    }
    else
    {
        ViewData["Title"] = p.Title;
        ViewData["Description"] = p.Summary;
        if (!string.IsNullOrWhiteSpace(p.HeroImage) && !Media.IsVideo(p.HeroImage)) ViewData["OgImage"] = p.HeroImage;

        var site = await SiteProfile.GetAsync();
        var absBase = await SeoHelpers.AbsoluteBaseAsync(HttpContext);
        breadcrumbLd = SeoHelpers.BreadcrumbJsonLd(absBase, ("Home", "/"), (copy.Title, "/projects"), (p.Title, $"/projects/{p.Slug}"));

        // No reliable ISO datePublished for a case study (Period is free text like
        // "2022-2023"), so it's omitted rather than guessed — same reasoning as the
        // sitemap's <lastmod> omission for project routes.
        var project = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "CreativeWork",
            ["name"] = p.Title,
            ["description"] = p.Summary,
            ["url"] = $"{absBase}/projects/{p.Slug}",
            ["author"] = new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = site.OwnerName, ["url"] = site.Url },
        };
        if (p.Tech.Count > 0) project["keywords"] = string.Join(", ", p.Tech);
        projectLd = System.Text.Json.JsonSerializer.Serialize(project);
    }
}
@if (breadcrumbLd is not null)
{
    <script type="application/ld+json">@Html.Raw(breadcrumbLd)</script>
    <script type="application/ld+json">@Html.Raw(projectLd)</script>
}

@if (p is null)
{
    <section class="container-page py-24 text-center">
        <p class="eyebrow">404</p>
        <h1 class="mt-3 text-3xl">@Text($"{item} not found")</h1>
        <a href="/projects" class="btn btn-ghost mt-6">@Text($"← Back to {section.Label}")</a>
    </section>
}
else
{
    <article class="container-page py-16 md:py-20">
        <a href="/projects" class="font-mono text-xs text-muted hover:text-accent">@Text($"← {section.Label}")</a>

        <header class="mt-6 max-w-3xl">
            <p class="eyebrow">@Text(item)</p>
            <h1 class="mt-3 text-3xl leading-tight md:text-5xl">@p.Title</h1>
            <p class="mt-3 font-mono text-xs text-muted">
                @string.Join(" · ", new[] { p.Role, p.Org, p.Period }.Where(x => !string.IsNullOrWhiteSpace(x)))
            </p>
            <p class="mt-5 text-lg text-muted">@p.Summary</p>
        </header>

        @if (!string.IsNullOrWhiteSpace(p.HeroImage))
        {
            <figure class="mt-10 overflow-hidden rounded-lg border border-border">
                @if (Media.IsVideo(p.HeroImage))
                {
                    <video class="aspect-video w-full object-cover" controls playsinline preload="metadata">
                        <source src="@p.HeroImage" />
                    </video>
                }
                else
                {
                    <img src="@p.HeroImage" alt="@p.Title" class="aspect-video w-full object-cover" width="1200" height="675" fetchpriority="high" />
                }
            </figure>
        }

        @if (p.Impact.Count > 0)
        {
            <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var m in p.Impact)
                {
                    <div class="card">
                        <p class="font-mono text-sm text-accent">▸ @m</p>
                    </div>
                }
            </div>
        }

        <div class="mt-12 grid gap-10 md:grid-cols-[1.6fr_1fr]">
            <div class="article max-w-2xl">
                @if (!string.IsNullOrWhiteSpace(p.Problem))
                {
                    <h2>@Text(copy.ProblemHeading)</h2>
                    <p>@p.Problem</p>
                }
                @if (!string.IsNullOrWhiteSpace(p.Approach))
                {
                    <h2>@Text(copy.ApproachHeading)</h2>
                    <p>@p.Approach</p>
                }
                @if (string.IsNullOrWhiteSpace(p.Problem) && string.IsNullOrWhiteSpace(p.Approach))
                {
                    <p class="text-muted">@Text(copy.NoWriteup)</p>
                }
            </div>

            <aside class="space-y-6">
                @if (p.Tech.Count > 0)
                {
                    <div>
                        <p class="eyebrow">@Text(copy.StackHeading)</p>
                        <div class="mt-3 flex flex-wrap gap-2">
                            @foreach (var t in p.Tech)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                    </div>
                }
                @if (p.Links.Count > 0)
                {
                    <div>
                        <p class="eyebrow">@Text(copy.LinksHeading)</p>
                        <ul class="mt-3 space-y-2">
                            @foreach (var l in p.Links)
                            {
                                <li><a href="@l.Url" target="_blank" rel="noopener" class="font-mono text-xs text-accent hover:text-accent-strong">@l.Label →</a></li>
                            }
                        </ul>
                    </div>
                }
                @if (p.Proofs.Count > 0)
                {
                    <div>
                        <p class="eyebrow">@Text(copy.ProofHeading)</p>
                        <ul class="mt-3 space-y-2">
                            @foreach (var pr in p.Proofs)
                            {
                                <li><a href="@pr.Url" target="_blank" rel="noopener" class="font-mono text-xs text-accent hover:text-accent-strong">@pr.Label →</a></li>
                            }
                        </ul>
                    </div>
                }
            </aside>
        </div>

        @if (p.Screenshots.Count > 0)
        {
            <section class="mt-14" data-lightbox-gallery aria-label="Screenshots">
                <p class="eyebrow">@Text(copy.ScreenshotsHeading)</p>
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @for (var i = 0; i < p.Screenshots.Count; i++)
                    {
                        var shot = p.Screenshots[i];
                        var shotIsVideo = Media.IsVideo(shot.Url);
                        <button type="button"
                                class="group relative block overflow-hidden rounded-lg border border-border transition hover:border-accent/50"
                                data-lightbox-item data-src="@shot.Url" data-caption="@shot.Caption" data-video="@(shotIsVideo ? "true" : "false")" data-index="@i"
                                aria-label="Open @(shotIsVideo ? "video" : "screenshot")@(string.IsNullOrWhiteSpace(shot.Caption) ? "" : ": " + shot.Caption)">
                            @if (shotIsVideo)
                            {
                                <video class="aspect-video w-full object-cover" muted playsinline preload="metadata">
                                    <source src="@shot.Url" />
                                </video>
                            }
                            else
                            {
                                <img src="@shot.Url" alt="@(shot.Caption ?? p.Title + " screenshot")" loading="lazy"
                                     class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
                            }
                            <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-bg/40 opacity-0 transition group-hover:opacity-100">
                                <span class="font-mono text-xs text-text">@(shotIsVideo ? "▶ play" : "⤢ view")</span>
                            </span>
                        </button>
                    }
                </div>
            </section>
        }
    </article>
}
