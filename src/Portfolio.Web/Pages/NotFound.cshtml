@page "/not-found"
@{
    // Served for any request that ends in an empty 404 (unknown address, or a page of a section the template does not have),
    // by the status code middleware in Program.cs. It names nothing about why, so it cannot reveal which sections exist.
    Response.StatusCode = 404;
    ViewData["Title"] = "Not found";
    ViewData["Robots"] = "noindex,nofollow";
}

<section class="container-page py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-3xl">Page not found</h1>
    <a href="/" class="btn btn-ghost mt-6">← Back to home</a>
</section>
