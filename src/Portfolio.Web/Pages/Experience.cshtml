@page "/experience"
@attribute [SectionPage(SectionRegistry.Experience)]
@inject PortfolioContentService Repo
@inject RequestTemplate Template
@{
    var tpl = await Template.GetAsync();
    var copy = tpl.Copy.Experience;
    ViewData["Title"] = copy.Title;
    ViewData["Description"] = TemplateSeo.ApplyDescription(copy.Description, tpl.Site);
    var roles = await Repo.GetExperiencesAsync();
    var absBase = await SeoHelpers.AbsoluteBaseAsync(HttpContext);
    var breadcrumbLd = SeoHelpers.BreadcrumbJsonLd(absBase, ("Home", "/"), (copy.Title, "/experience"));
}
<script type="application/ld+json">@Html.Raw(breadcrumbLd)</script>

<section class="container-page py-16 md:py-20">
    <p class="eyebrow">@Text(copy.Eyebrow)</p>
    <h1 class="mt-3 text-3xl md:text-4xl">@Text(copy.Heading)</h1>
    <p class="lead">@Text(copy.Lead)</p>

    @if (roles.Count == 0)
    {
        <p class="mt-10 font-mono text-sm text-muted">@Text(copy.Empty)</p>
    }
    else
    {
        <div class="mt-12 space-y-10 border-l border-border pl-6 md:pl-8">
            @foreach (var r in roles)
            {
                <article class="relative">
                    <span class="absolute -left-[31px] top-1.5 h-2.5 w-2.5 rounded-full @(r.Current ? "bg-accent" : "bg-border") md:-left-[39px]"></span>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                        <h2 class="text-xl text-text">@r.Company</h2>
                        <span class="font-mono text-xs text-muted">@r.Start – @(r.Current ? "present" : r.End)</span>
                    </div>
                    <p class="mt-1 font-mono text-sm text-accent">@r.Title</p>
                    <p class="mt-3 max-w-2xl text-muted">@r.Summary</p>
                    @if (r.Highlights.Count > 0)
                    {
                        <ul class="mt-3 space-y-1.5">
                            @foreach (var h in r.Highlights)
                            {
                                <li class="text-sm text-muted"><span class="text-accent">▸</span> @h</li>
                            }
                        </ul>
                    }
                    @if (r.Tech.Count > 0)
                    {
                        <div class="mt-4 flex flex-wrap gap-2">
                            @foreach (var t in r.Tech)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>
